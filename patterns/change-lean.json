{
  "$schema": "./pattern.schema.json",
  "$comment": "Change without its last step: the lead's verification run. Nothing reads verification artifacts today. A variant cannot remove a step, so this is a full pattern.",
  "id": "change-lean",
  "name": "Change without the lead's verification",
  "order": 95,
  "experimental": true,
  "hypothesis": "Final checks and a clean independent review are enough evidence. The lead's verification run adds cost without changing outcomes.",
  "description": "Change without the lead's verification run: implement, checks, review, repair if needed, and it ends with the final checks.",
  "whenToUse": "Measure whether the verification run is worth its cost.",
  "steps": [
    {
      "id": "S1",
      "purpose": "Implement",
      "role": "coder",
      "dependsOn": [],
      "inputs": [],
      "outputs": [
        { "name": "change", "kind": "code-change" },
        { "name": "handoff", "kind": "handoff" }
      ]
    },
    {
      "id": "C1",
      "purpose": "Run the project's checks",
      "role": "checks",
      "dependsOn": ["S1"],
      "inputs": [{ "step": "S1", "output": "change" }],
      "outputs": [{ "name": "checks", "kind": "check-results" }],
      "checks": { "onFail": "findings" }
    },
    {
      "id": "S2",
      "purpose": "Code review",
      "role": "code_reviewer",
      "dependsOn": ["S1", "C1"],
      "inputs": [
        { "step": "S1", "output": "change" },
        { "step": "S1", "output": "handoff" },
        { "step": "C1", "output": "checks" }
      ],
      "outputs": [{ "name": "findings", "kind": "review-findings" }]
    },
    {
      "id": "S3",
      "purpose": "Repair review findings and failing checks",
      "role": "coder",
      "dependsOn": ["S2"],
      "inputs": [
        { "step": "S1", "output": "change" },
        { "step": "S2", "output": "findings" },
        { "step": "C1", "output": "checks" }
      ],
      "outputs": [{ "name": "change", "kind": "code-change" }],
      "runIf": [
        { "step": "C1", "output": "checks" },
        { "step": "S2", "output": "findings" }
      ],
      "iterate": { "from": "C1", "max": 3 }
    },
    {
      "id": "C2",
      "purpose": "Final checks",
      "role": "checks",
      "dependsOn": ["S3"],
      "inputs": [
        { "step": "S1", "output": "change" },
        { "step": "S3", "output": "change" }
      ],
      "outputs": [{ "name": "final", "kind": "check-results" }],
      "checks": { "onFail": "block" }
    }
  ]
}
