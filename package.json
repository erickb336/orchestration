{
  "name": "orchestrator",
  "private": true,
  "version": "0.1.0",
  "bin": {
    "orchestrator": "scripts/orchestrator.mjs"
  },
  "type": "module",
  "scripts": {
    "dev": "node scripts/dev.mjs",
    "server": "node --import tsx server/main.ts",
    "build": "tsc -b && tsc -p tsconfig.server.json && vite build",
    "start": "node scripts/orchestrator.mjs start",
    "typecheck": "tsc -b --noEmit && tsc -p tsconfig.server.json",
    "principles": "node --import tsx scripts/principles.mjs",
    "lint:prose": "node --import tsx scripts/lint-prose.mjs",
    "pretest": "npm run principles --silent",
    "test": "vitest run",
    "test:integration": "node --import tsx scripts/real-run-test.mjs --fake",
    "test:real": "node --import tsx scripts/real-run-test.mjs",
    "trial:studio": "node --import tsx scripts/studio-trial.mjs",
    "recorder:build": "docker build --tag orchestrator-recorder:2 docker/recorder",
    "preview": "vite preview",
    "setup": "node scripts/orchestrator.mjs setup",
    "status": "node scripts/orchestrator.mjs status",
    "capture": "node scripts/capture-demo.mjs"
  },
  "dependencies": {
    "@anthropic-ai/claude-agent-sdk": "0.3.285",
    "@noble/hashes": "2.4.0",
    "@openai/codex": "0.159.2",
    "ajv": "8.20.0",
    "canonicalize": "5.1.0",
    "driver.js": "1.8.0",
    "fast-xml-parser": "5.11.2",
    "mermaid": "11.17.2",
    "react": "^19.3.0",
    "react-dom": "^19.3.0",
    "react-markdown": "10.1.0",
    "remark-gfm": "4.0.1"
  },
  "devDependencies": {
    "@types/node": "^26.6.3",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.1.1",
    "playwright-core": "1.63.0",
    "tsx": "^4.23.15",
    "typescript": "^7.0.2",
    "vite": "^8.3.1",
    "vitest": "^5.0.2"
  },
  "engines": {
    "node": ">=22.13"
  },
  "description": "A local orchestrator for Claude and Codex agent teams: one lead, versioned task specs, six flows, and optional human-in-the-loop.",
  "license": "MIT",
  "author": "Erick Benitez-Ramos",
  "repository": {
    "type": "git",
    "url": "https://github.com/erickb336/orchestrator.git"
  }
}
