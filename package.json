{
  "name": "orchestration",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev": "node scripts/dev.mjs",
    "server": "node --import tsx server/main.ts",
    "build": "tsc -b && tsc -p tsconfig.server.json && vite build",
    "start": "npm run build && node scripts/start.mjs",
    "typecheck": "tsc -b --noEmit && tsc -p tsconfig.server.json",
    "test": "vitest run",
    "preview": "vite preview"
  },
  "dependencies": {
    "@anthropic-ai/claude-agent-sdk": "0.3.285",
    "@openai/codex": "0.159.2",
    "react": "^19.3.0",
    "react-dom": "^19.3.0"
  },
  "devDependencies": {
    "@types/node": "^26.6.3",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.1.1",
    "tsx": "^4.23.15",
    "typescript": "^7.0.2",
    "vite": "^8.3.1",
    "vitest": "^5.0.2"
  },
  "engines": {
    "node": ">=22.13"
  },
  "description": "A local orchestrator for Claude and Codex agent teams: one lead, versioned task specs, editable pipelines, and optional human-in-the-loop.",
  "license": "MIT",
  "author": "Erick Benitez-Ramos",
  "repository": {
    "type": "git",
    "url": "https://github.com/erickb336/orchestration.git"
  }
}
