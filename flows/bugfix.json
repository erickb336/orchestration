{
  "$schema": "./flow.schema.json",
  "$comment": "ORC-021: SR1 is a security review that runs beside the code review; the repair runs when either has findings.",
  "id": "bugfix",
  "name": "Bug fix",
  "description": "Reproduce first, fix, checks, code and security review in parallel, repair if needed, final checks, verify the reproduction no longer fails.",
  "whenToUse": "A defect you can reproduce.",
  "steps": [
    {
      "id": "S1",
      "purpose": "Reproduce and diagnose",
      "role": "coder",
      "dependsOn": [],
      "inputs": [],
      "outputs": [{ "name": "reproduction", "kind": "report" }],
      "principles": ["fix-root-causes", "prove-it-works"]
    },
    {
      "id": "S2",
      "purpose": "Fix",
      "role": "coder",
      "dependsOn": ["S1"],
      "inputs": [{ "step": "S1", "output": "reproduction" }],
      "outputs": [
        { "name": "change", "kind": "code-change" },
        { "name": "handoff", "kind": "handoff" }
      ],
      "principles": ["laziness-protocol", "test-behavior-not-implementation", "migrate-callers-then-delete-legacy-apis", "fix-root-causes", "prove-it-works"]
    },
    {
      "id": "C1",
      "purpose": "Run the project's checks",
      "role": "checks",
      "dependsOn": ["S2"],
      "inputs": [{ "step": "S2", "output": "change" }],
      "outputs": [{ "name": "checks", "kind": "check-results" }],
      "checks": { "onFail": "findings" }
    },
    {
      "id": "S3",
      "purpose": "Code review",
      "role": "code_reviewer",
      "dependsOn": ["S2", "C1"],
      "inputs": [
        { "step": "S1", "output": "reproduction" },
        { "step": "S2", "output": "change" },
        { "step": "S2", "output": "handoff" },
        { "step": "C1", "output": "checks" }
      ],
      "outputs": [{ "name": "findings", "kind": "review-findings" }],
      "principles": ["laziness-protocol", "test-behavior-not-implementation", "migrate-callers-then-delete-legacy-apis", "minimize-reader-load"]
    },
    {
      "id": "SR1",
      "purpose": "Security review",
      "role": "security_reviewer",
      "dependsOn": ["S2", "C1"],
      "inputs": [
        { "step": "S1", "output": "reproduction" },
        { "step": "S2", "output": "change" },
        { "step": "S2", "output": "handoff" },
        { "step": "C1", "output": "checks" }
      ],
      "outputs": [{ "name": "findings", "kind": "review-findings" }],
      "principles": ["boundary-discipline"]
    },
    {
      "id": "S4",
      "purpose": "Repair review findings and failing checks",
      "role": "coder",
      "dependsOn": ["S3", "SR1"],
      "inputs": [
        { "step": "S2", "output": "change" },
        { "step": "S3", "output": "findings" },
        { "step": "SR1", "output": "findings" },
        { "step": "C1", "output": "checks" }
      ],
      "outputs": [{ "name": "change", "kind": "code-change" }],
      "runIf": [
        { "step": "C1", "output": "checks" },
        { "step": "S3", "output": "findings" },
        { "step": "SR1", "output": "findings" }
      ],
      "iterate": { "from": "C1", "max": 3 },
      "principles": ["laziness-protocol", "migrate-callers-then-delete-legacy-apis", "fix-root-causes"]
    },
    {
      "id": "C2",
      "purpose": "Final checks",
      "role": "checks",
      "dependsOn": ["S4"],
      "inputs": [
        { "step": "S2", "output": "change" },
        { "step": "S4", "output": "change" }
      ],
      "outputs": [{ "name": "final", "kind": "check-results" }],
      "checks": { "onFail": "block" }
    },
    {
      "id": "S5",
      "purpose": "Verify the reproduction no longer fails, then integrate",
      "role": "lead",
      "dependsOn": ["C2"],
      "inputs": [
        { "step": "S1", "output": "reproduction" },
        { "step": "S2", "output": "change" },
        { "step": "S4", "output": "change" },
        { "step": "S3", "output": "findings" },
        { "step": "SR1", "output": "findings" },
        { "step": "C2", "output": "final" }
      ],
      "outputs": [{ "name": "verification", "kind": "verification" }],
      "principles": ["prove-it-works"]
    }
  ]
}
