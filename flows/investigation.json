{
  "$schema": "./flow.schema.json",
  "id": "investigation",
  "name": "Investigation",
  "description": "Gather evidence, review it, revise the report while the review finds something (up to three rounds), and propose a follow-up implementation spec.",
  "whenToUse": "The cause or the right change is unknown; the result is a spec, not code.",
  "steps": [
    {
      "$comment": "ORC-031: read-only research. The step changes no file, and its workspace is read-only whatever its role.",
      "id": "S1",
      "purpose": "Investigate and gather evidence",
      "role": "coder",
      "research": true,
      "dependsOn": [],
      "inputs": [],
      "outputs": [{ "name": "report", "kind": "report" }],
      "principles": ["fix-root-causes", "prove-it-works"]
    },
    {
      "id": "S2",
      "purpose": "Review evidence for gaps",
      "role": "code_reviewer",
      "dependsOn": ["S1"],
      "inputs": [{ "step": "S1", "output": "report" }],
      "outputs": [{ "name": "findings", "kind": "review-findings" }],
      "principles": ["prove-it-works"]
    },
    {
      "$comment": "ORC-028: the review's findings are repaired, as in every other flow; the real run of 2026-10-01 had one dropped.",
      "id": "S3",
      "purpose": "Revise the report",
      "role": "coder",
      "dependsOn": ["S2"],
      "inputs": [
        { "step": "S1", "output": "report" },
        { "step": "S2", "output": "findings" }
      ],
      "outputs": [{ "name": "report", "kind": "report" }],
      "runIf": [{ "step": "S2", "output": "findings" }],
      "iterate": { "from": "S2", "max": 3 },
      "principles": ["fix-root-causes", "prove-it-works"]
    },
    {
      "id": "S4",
      "purpose": "Propose follow-up spec",
      "role": "lead",
      "dependsOn": ["S3"],
      "inputs": [
        { "step": "S1", "output": "report" },
        { "step": "S3", "output": "report" },
        { "step": "S2", "output": "findings" }
      ],
      "outputs": [{ "name": "brief", "kind": "brief" }],
      "principles": ["fix-root-causes"]
    }
  ]
}
